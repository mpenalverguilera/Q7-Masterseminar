@INPROCEEDINGS{11647973,
  author={Gudipuri, Nithesh},
  booktitle={2026 International Conference on Cybersecurity, Digital Forensics, and AI Applications (ICCSDFAI)}, 
  title={StickyMemory: Robust Web Agents with Episodic Memory and Self-Verification}, 
  year={2026},
  volume={},
  number={},
  pages={1281-1286},
  abstract={Tools effects are never checked, and early decisions are often lost, which makes web agents very difficult with long and multi-step tasks. We introduce StickyMemory, a simple controller that combines a behavior-cloned actuator with two extensions rolling episodic memory summaries and a simple self-verifier that reflows key steps to establish DOM and tool invariants. In case of a mismatch being recognized a plan-repair phase also restarts where the last consistent checkpoint was rather than starting the episode from the beginning. StickyMemory is tested on WebArena, VisualWebArena and Mind2Web, benchmarked against ReAct, Reflexion, and no-memory policy on standardized prompts, tools, seeds, and step-budgets. StickyMemory increases success rates, decreases timeouts and steps across test suites, e.g., in WebArena, it increases success to 64.6% and in VisualWebArena, it increases success to 58.9% and in Mind2Web, it increases success to 59.1%, and the median steps is lower, and the timeouts are also lower than strong prompts baselines. The verifier is highly precise and recalls, and ablations exhibit a distinct knee in its performance at a small memory horizon. It has a modular design that makes it model-agnostic and can be retrofitted to existing web agents.},
  keywords={Cloning;Memory;Tools;Modeling;Planning;Manuals;Maintenance engineering;Actuators;Large language models;Application programming interfaces;Web agents;episodic memory;self-verification;plan repair;behavior cloning},
  doi={10.1109/ICCSDFAI70505.2026.11647973},
  ISSN={},
  month={June},}@INPROCEEDINGS{10328964,
  author={Nelaturu, Keerthi and Keilty, Eric and Veneris, Andreas},
  booktitle={2023 Tenth International Conference on Software Defined Systems (SDS)}, 
  title={Natural Language-Based Model-Checking Framework for Move Smart Contracts}, 
  year={2023},
  volume={},
  number={},
  pages={89-94},
  abstract={Significant efforts have been dedicated to employing model-checking as a formal verification approach in the context of smart contracts. The utilization of these tools necessitates an in-depth knowledge on the part of the developer regarding both the programming language and the implementation of model-checking techniques. To provide accessibility to developers with basic language proficiency, we present a technique for developing a conversational application framework that can be seamlessly linked with any model-checking tool for the purpose of creating a smart contract. This architecture offers a robust and effective approach to the development of safe and dependable smart contracts. The utilization of natural language processing techniques in conjunction with neural networks is employed for this objective. Using this methodology, a prototype implementation for Move smart contracts has been created and is used with the VeriMove model-checking tool. Using the offered graphical user interface, we were able to successfully build, compile and test Move smart contracts across four different classes of smart contracts. This strategy effectively decreases the amount of time and effort needed for manual coding and debugging. In addition, the use of the VeriMove model-checking tool guarantees that the smart contracts produced are devoid of any potential vulnerabilities and flaws.},
  keywords={Sentiment analysis;Smart contracts;Neural networks;Prototypes;Oral communication;Manuals;Predictive models;move;smart contracts;NLP;model-checking},
  doi={10.1109/SDS59856.2023.10328964},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{9753518,
  author={KH, Kochaleema and Mansoor, Serina and G, Santhoshkumar},
  booktitle={2022 IEEE Delhi Section Conference (DELCON)}, 
  title={Automatic Formal Model Generation from UML Diagrams – An Implementation Experience}, 
  year={2022},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper discusses the implementation of a formal method integrated Unified Modeling Language (UML) modelling methodology for the verification of embedded software specifications. The methodology generates mathematically verifiable models, synergising UML visual models with formal methods. The implementation is carried out using Umbrello UML Modeller and Qt. It provides a Graphical User Interface-based tool and a model checking engine, integrated into Umbrello UML Modeller, which can interpret UML diagrams and generate a formal model automatically. The tool architecture has three distinct layers: the UML, Interface, and Formal layers; the Interface layer is the innovative one. GUI is developed for this layer, and all the actions associated with the Interface layer are made available through interactive menus and toolbars.},
  keywords={Visualization;Computational modeling;IEEE Sections;Unified modeling language;Model checking;Mathematical models;Reliability;Computational Tree Logic;Formal Verification;Linear Temporal Logic;Property Specification;State Chart Diagram;State Transition Matrix;UML Modelling},
  doi={10.1109/DELCON54057.2022.9753518},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11068386,
  author={Unniyankal, Hisham and Ancona, Davide and Ferrando, Angelo and Parodi, Fabio and Alessi, Alessandro and Bottino, Federico},
  booktitle={2025 55th Annual IEEE/IFIP International Conference on Dependable Systems and Networks - Supplemental Volume (DSN-S)}, 
  title={Runtime Verification of Program Organization Units in Safe Programmable Logic Controller Systems}, 
  year={2025},
  volume={},
  number={},
  pages={112-118},
  abstract={Programmable Logic Controllers (PLCs) play an essential role in industrial automation by managing complex safety-critical processes. Ensuring the safety and correctness of PLC programs is important, particularly in safety-critical interconnected systems. Although formal verification methods, such as model checking, provide correctness guarantees, they are often impractical for complex PLC systems owing to scalability limitations. Additionally, increased system interconnectivity introduces potential security vulnerabilities. This paper proposes a Runtime Verification (RV) approach to enhance the safety, security, and correctness of PLC programs. Our solution enables users to synthesize runtime monitors through a Graphical User Interface (GUI), using C as the specification language. The synthesized monitors verify the execution of Program Organization Units (POUs) without altering the PLC control flow, ensuring compliance with the defined safety properties. By integrating RV into the PLC execution, we are able to provide a lightweight and adaptable approach for detecting violations and ensuring system reliability. We report preliminary experimental results on the application of our solution to two different case studies, one on a Piped Gas Control Subsystem (PGCS) and the other on a Temperature Control System (TCS). In both cases, we show that the computational and memory overhead introduced by our synthesized monitors is negligible, thus demonstrating that program organization units can still run effectively while being monitored.},
  keywords={Temperature sensors;Temperature measurement;Runtime;Programmable logic devices;Organizations;Specification languages;Safety;Timing;Logic;Monitoring;Runtime Verification;Programmable Logic Controllers;Safety-Critical Industrial Control Systems;Integrated Development Environment},
  doi={10.1109/DSN-S65789.2025.00050},
  ISSN={2833-292X},
  month={June},}@INPROCEEDINGS{11380695,
  author={Yang, Jingwen and Zhang, Zihang and Deng, Hao and Zhou, Kangqi and Chen, Gang},
  booktitle={2025 16th International Conference on Software Engineering and Service Science (ICSESS)}, 
  title={A Coq-based Interactive Verification Tool for Analog Circuits}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Printed circuit board design relies on EDA (Electronic Design Automation) tools, and ensuring the correctness of analog circuit design is a crucial step in the design process. This article introduces an interactive verification tool for analog circuits based on the Coq theorem prover, and develops a graphical user interface that combines formal verification. The interface enables users to draw analog circuit diagrams and automatically convert them into Coq description code, significantly enhancing the efficiency of the verification process. By using the tool, we draw a series of typical linear analog circuit diagrams and generate their Coq descriptions. Furthermore, we use theorem provers to verify that the physical quantities of the circuit design meet the expected standards. The experimental results indicate that formal verification can be effectively applied to analog circuit design, providing new research directions and practical methods for software engineering.},
  keywords={Human computer interaction;Design automation;Codes;Printed circuits;Analog circuits;Circuit synthesis;Standards;Formal verification;Graphical user interfaces;software engineering;human-computer interaction;analog circuit analysis;formal verification;EDA;Coq},
  doi={10.1109/ICSESS67729.2025.11380695},
  ISSN={2327-0594},
  month={Dec},}@INPROCEEDINGS{9964958,
  author={Faujdar, Neetu and Yadav, Anupam},
  booktitle={2022 10th International Conference on Reliability, Infocom Technologies and Optimization (Trends and Future Directions) (ICRITO)}, 
  title={GUI Calculator Testing for Finite State Machine}, 
  year={2022},
  volume={},
  number={},
  pages={1-5},
  abstract={In this paper, we have proposed the testing of the Graphical User Interface (GUI) applications using the idea of finite state machines. Results have been compares with the model generated using Simulink's script, represents the machine that tested the actual GUI. This environment can help in writing efficient test cases to test the actual graphical interfaces of the application under the test. For the testing of our system, a small GUI for the calculator has been developed, and then the finite state diagram for the same design has been used as a machine for the simulation. The results from the Simulink model are compared with the actual application. The defects are also identified and have been presented.},
  keywords={Calculators;Software packages;Automata;Market research;Reliability;Optimization;Biological cells;Genetic Algorithm;Finite State Machine;Testing;Test Case Generation},
  doi={10.1109/ICRITO56286.2022.9964958},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{9402354,
  author={Liu, Changlin},
  booktitle={2021 IEEE/ACM 43rd International Conference on Software Engineering: Companion Proceedings (ICSE-Companion)}, 
  title={ProMal: Precise Window Transition Graphs for Android via Synergy of Program Analysis and Machine Learning}, 
  year={2021},
  volume={},
  number={},
  pages={144-146},
  abstract={Mobile apps have been an integral part in our daily life. As these apps become more complex, it is critical to provide automated analysis techniques to ensure the correctness, security, and performance of these apps. A key component for these automated analysis techniques is to create a graphical user interface (GUI) model of an app, i.e., a window transition graph (WTG), that models windows and transitions among the windows. While existing work has provided both static and dynamic analysis to build the WTG for an app, the constructed WTG misses many transitions or contains many infeasible transitions due to the coverage issues of dynamic analysis and over-approximation of the static analysis. We propose ProMal, a "tribrid" analysis that synergistically combines static analysis, dynamic analysis, and machine learning to construct a precise WTG. Specifically, ProMal first applies static analysis to build a static WTG, and then applies dynamic analysis to verify the transitions in the static WTG. For the unverified transitions, ProMal further provides machine learning techniques that leverage runtime information (i.e., screenshots, UI layouts, and text information) to predict whether they are feasible transitions. Our evaluations on 40 real-world apps demonstrate the superiority of ProMal in building WTGs over static analysis, dynamic analysis, and machine learning techniques when they are applied separately.},
  keywords={Analytical models;Runtime;Static analysis;Machine learning;Windows;Security;Graphical user interfaces;Android;Window Transition Graph;GUI Testing;Static Analysis;Dynamic Analysis;Machine Learning},
  doi={10.1109/ICSE-Companion52605.2021.00061},
  ISSN={2574-1926},
  month={May},}@INPROCEEDINGS{11334713,
  author={Rafie, Bassel and Schindler, Christian and Rausch, Andreas},
  booktitle={2025 40th IEEE/ACM International Conference on Automated Software Engineering Workshops (ASEW)}, 
  title={VeriODD: From YAML to SMT-LIB - Automating Verification of Operational Design Domains}, 
  year={2025},
  volume={},
  number={},
  pages={165-168},
  abstract={Operational Design Domains (ODDs) define the conditions under which an Automated Driving System (ADS) is allowed to operate, while Current Operational Domains (CODs) capture the actual runtime situation. Ensuring that a COD instance lies within the ODD is a crucial step in safety assurance. Today, ODD and COD specifications are frequently expressed in YAML to remain accessible for stakeholders, but such descriptions are not directly suitable for solver-based verification. Manual translation into formal languages such as SMT-LIB is slow and error-prone. We present VeriODD, a tool that automates this translation. VeriODD uses ANTLR-based compiler technology to transform YAML-based ODD/COD specifications into both human-readable propositional logic, for lightweight review on a simple basis, and solver-ready SMT-LIB. The tool integrates with SMT solvers such as Z3 to provide automated consistency checks of ODD specifications and verification of COD conformance. A graphical user interface supports editing specifications, inspecting generated formulas, and performing verification with a single click. VeriODD thereby closes the gap between stakeholder-friendly ODD/COD notations and formal verification, enabling scalable and automated assurance of operational boundaries in autonomous driving.},
  keywords={Translation;Runtime;Reviews;Transforms;Manuals;Safety;Stakeholders;Logic;Formal verification;Graphical user interfaces;operational design domain;automated driving systems;safety-critical systems;formal verification;ANTLR},
  doi={10.1109/ASEW67777.2025.00039},
  ISSN={2151-0849},
  month={Nov},}@INPROCEEDINGS{10457719,
  author={Volk, Matthias and Sher, Falak and Katoen, Joost-Pieter and Stoelinga, Mariëlle},
  booktitle={2024 Annual Reliability and Maintainability Symposium (RAMS)}, 
  title={SAFEST: Fault Tree Analysis Via Probabilistic Model Checking}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={This paper presents SAFEST, a powerful tool for modelling and analyzing both static and dynamic fault trees. Dynamic fault trees (DFTs) extend standard fault trees by providing support for faithfully modelling spare management, functional dependencies, and order-dependent failures. The SAFEST tool provides efficient and powerful analysis of DFTs via probabilistic model checking – a rigorous, automated analysis technique for probabilistic systems. The backbone of the analysis is based on efficient state space generation. Several optimization techniques are incorporated, such as exploiting irrelevant failures, symmetries, and independent modules. Probabilistic model checking allows to analyze the resulting state space with respect to a wide range of measures of interest. In addition, an approximation approach is provided that builds only parts of the state space and allows to iteratively refine the computations up to the desired accuracy. The SAFEST tool provides a graphical user interface for creating, generating, simulating, and simplifying fault trees as well as visualizing the results from the fault tree analysis. SAFEST is state of the art for DFT analysis, as demonstrated by an experimental evaluation and comparison with existing tools. In addition, SAFEST and DFT models have been applied in a variety of case studies, including vehicle guidance systems, train operations in railway station areas, and energy systems such as (nuclear) power plants.},
  keywords={Analytical models;Visualization;Discrete Fourier transforms;Model checking;Probabilistic logic;Vehicle dynamics;Optimization;dynamic fault trees;fault tree analysis;Markov models;model checking},
  doi={10.1109/RAMS51492.2024.10457719},
  ISSN={2577-0993},
  month={Jan},}@ARTICLE{10750160,
  author={Zamora-Mejia, Gregorio and Carbajal-Gomez, Victor H. and Alvarez-Simon, Luis C. and Silva-Juarez, Alejandro and Bautista-Castillo, Alejandro I. and Rosales-Nunez, Sergio A. and Rocha-Perez, Jose M. and Barbosa-Escudero, Francisco and Sanchez-Dominguez, Margarita and Durini, Daniel},
  journal={IEEE Access}, 
  title={iSensMex-POT, a Potentiostat Platform for Human Health Applications}, 
  year={2024},
  volume={12},
  number={},
  pages={169050-169068},
  abstract={This work introduces the iSensMEX-POT platform, a potentiostat-based detection system for conducting cyclic voltammetry measurements. It consists of a mixed-mode application-specific integrated circuit (ASIC) and a user digital interface unit based on Raspberry/Python platform. The ASIC consists of three main building blocks: a potentiostat built by three operational amplifiers (OpAmps) working as an analog front-end, a 10-bit R2R digital-to-analog converter (DAC) and a 10-bit successive-approximation analog-to-digital converter (SAR-ADC) composing the mixed signal mode processing stage, and a digital finite state machine using the Inter-Integrated Circuit (I2C) protocol conforming the digital data processing and transmission section. The Raspberry controls the ASIC using the I2C, writes a digital words into the ASIC’s registers to replicate a triangular cyclic voltammetry signal with a scan rate of 200 mV/s over a range of ±1 V, and reads the digitized data from the SAR-ADC. The Raspberry platform displays the resulting waveform on a touch-screen using a graphical user interface (GUI). Also, a precision model based on the open-loop gain of the amplifier and an output noise quantification model were developed and applied to design a highly accurate potentiostat based on three amplifiers. The proposed platform’s functionality and accuracy was validated by comparing the data gathered by the iSensMex-POT with the data obtained with the EVAL-AD5940ELCZ commercial board. The proposed ASIC was mathematically modeled, simulated and fabricated in a 180 nm CMOS standard technology, featuring a silicon area of 1.39 mm2 and a power consumption of 52.99 mW (16.05 mA @ 3.3 V).},
  keywords={Computer architecture;Noise measurement;Gain measurement;Transistors;Universal Serial Bus;Microprocessors;Electrodes;Graphical user interfaces;Costs;Voltage control;Detection algorithms;Arsenic;bacteria;creatinine;cyclic voltammetry;drinking water;human health;I2C;molecules;potentiostat;virus},
  doi={10.1109/ACCESS.2024.3496353},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10298411,
  author={Zhang, Xiangyu and Fan, Lingling and Chen, Sen and Su, Yucheng and Li, Boyuan},
  booktitle={2023 38th IEEE/ACM International Conference on Automated Software Engineering (ASE)}, 
  title={Scene-Driven Exploration and GUI Modeling for Android Apps}, 
  year={2023},
  volume={},
  number={},
  pages={1251-1262},
  abstract={Due to the competitive environment, mobile apps are usually produced under pressure with lots of complicated functionality and UI pages. Therefore, it is challenging for various roles to design, understand, test, and maintain these apps. The extracted transition graphs for apps such as ATG, WTG, and STG have a low transition coverage and coarse-grained granularity, which limits the existing methods of graphical user interface (GUI) modeling by UI exploration. To solve these problems, in this paper, we propose SceneDroid, a scene-driven exploration approach to extracting the GUI scenes dynamically by integrating a series of novel techniques including smart exploration, state fuzzing, and indirect launching strategies. We present the GUI scenes as a scene transition graph (SceneTG) to model the GUI of apps with high transition coverage and fine-grained granularity. Compared with the existing GUI modeling tools, SceneDroid has improved by 168.74% in the coverage of transition pairs and 162.42% in scene extraction. Apart from the effectiveness evaluation of SceneDroid, we also illustrate the future potential of SceneDroid as a fundamental capability to support app development, reverse engineering, and GUI rearession testing.},
  keywords={Reverse engineering;Fuzzing;Mobile applications;Graphical user interfaces;Testing;Software engineering;Android app;Scene-driven exploration;GUI exploration;GUI modeling},
  doi={10.1109/ASE56229.2023.00179},
  ISSN={2643-1572},
  month={Sep.},}@INPROCEEDINGS{10172707,
  author={Liu, Zhe and Chen, Chunyang and Wang, Junjie and Su, Yuhui and Huang, Yuekai and Hu, Jun and Wang, Qing},
  booktitle={2023 IEEE/ACM 45th International Conference on Software Engineering (ICSE)}, 
  title={Ex pede Herculem: Augmenting Activity Transition Graph for Apps via Graph Convolution Network}, 
  year={2023},
  volume={},
  number={},
  pages={1983-1995},
  abstract={Mobile apps are indispensable for people's daily life. With the increase of GUI functions, apps have become more complex and diverse. As the Android app is event-driven, Activity Transition Graph (ATG) becomes an important way of app abstract and graphical user interface (GUI) modeling. Although existing works provide static and dynamic analysis to build ATG for applications, the completeness of ATG obtained is poor due to the low coverage of these techniques. To tackle this challenge, we propose a novel approach, ArchiDroid, to automatically augment the ATG via graph convolution network. It models both the semantics of activities and the graph structure of activity transitions to predict the transition between activities based on the seed ATG extracted by static analysis. The evaluation demonstrates that ArchiDroid can achieve 86% precision and 94% recall in predicting the transition between activities for augmenting ATG. We further apply the augmented ATG in two downstream tasks, i.e., guidance in automated GUI testing and assistance in app function design. Results show that the automated GUI testing tool integrated with ArchiDroid achieves 43% more activity coverage and detects 208% more bugs. Besides, ArchiDroid can predict the missing transition with 85% accuracy in real-world apps for assisting the app function design, and an interview case study further demonstrates its usefulness.},
  keywords={Convolution;Buildings;Semantics;Static analysis;Predictive models;Mobile applications;Task analysis;GUI testing;deep learning;program analysis;empirical study},
  doi={10.1109/ICSE48619.2023.00168},
  ISSN={1558-1225},
  month={May},}@INPROCEEDINGS{9794097,
  author={Liu, Changlin and Wang, Hanlin and Liu, Tianming and Gu, Diandian and Ma, Yun and Wang, Haoyu and Xiao, Xusheng},
  booktitle={2022 IEEE/ACM 44th International Conference on Software Engineering (ICSE)}, 
  title={PROMAL: Precise Window Transition Graphs for Android via Synergy of Program Analysis and Machine Learning}, 
  year={2022},
  volume={},
  number={},
  pages={1755-1767},
  abstract={Mobile apps have been an integral part in our daily life. As these apps become more complex, it is critical to provide automated analysis techniques to ensure the correctness, security, and performance of these apps. A key component for these automated analysis techniques is to create a graphical user interface (GUI) model of an app, i.e., a window transition graph (WTG), that models windows and transitions among the windows. While existing work has provided both static and dynamic analysis to build the WTG for an app, the constructed WTG misses many transitions or contains many infeasible transitions due to the coverage issues of dynamic analysis and over-approximation of the static analysis. We propose ProMal, a “tribrid” analysis that synergistically combines static analysis, dynamic analysis, and machine learning to construct a precise WTG. Specifically, ProMal first applies static analysis to build a static WTG, and then applies dynamic analysis to verify the transitions in the static WTG. For the unverified transitions, ProMal further provides machine learning techniques that leverage runtime information (i.e., screenshots, UI layouts, and text information) to predict whether they are feasible transitions. Our evaluations on 40 real-world apps demonstrate the superiority of ProMal in building WTGs over static analysis, dynamic analysis, and machine learning techniques when they are applied separately.},
  keywords={Analytical models;Runtime;Buildings;Static analysis;Machine learning;Windows;Performance analysis;mobile apps;window transition graph;static analysis;deep learning},
  doi={10.1145/3510003.3510037},
  ISSN={1558-1225},
  month={May},}@INPROCEEDINGS{9499255,
  author={Kapular, Bruno and Vranješ, Mario and Kaštelan, Ivan and Kovačević, Jelena},
  booktitle={2021 Zooming Innovation in Consumer Technologies Conference (ZINC)}, 
  title={Testing of Model Verifier within Software Development in Automotive Industry}, 
  year={2021},
  volume={},
  number={},
  pages={252-257},
  abstract={Modern vehicles are becoming more equipped every day with an increasing number of Advanced Driver-Assistance Systems (ADASs), and thus the amount of complex software on which these ADASs are based is growing. Although the introduction of standardization and automatic program code writing tools in the industry has somewhat facilitated the development of complex ADASs, there is still room for progress in the process of verifying their correctness. As manual writing of software tests for large systems is extremely time-consuming, more and more efforts are being made to automate this process. That is why a tool for automatic verification of models made according to the AUTOSAR standard, called System Definition Verifier (SDV), is being developed. However, this tool also requires verification itself as it is an automated tool. In this paper, a number of models are created to validate the SDV. As the use of the tool was found to be difficult, a graphical user interface (GUI) was created as part of this same project to make any future efforts easier. The created models and GUI are used to perform validation of specific SDV. Validation results given by the tested tool revealed that the SDV detected 97.26% of the error types present in the models, whereas the use of the created GUI accelerated the validation process significantly.},
  keywords={Industries;Analytical models;Technological innovation;Tools;Writing;Software;Zinc;automotive software;testing;model verifier;AUTOSAR},
  doi={10.1109/ZINC52049.2021.9499255},
  ISSN={},
  month={May},}@INPROCEEDINGS{9176837,
  author={Walkinshaw, Neil},
  booktitle={2020 IEEE International Conference On Artificial Intelligence Testing (AITest)}, 
  title={Improving Automated GUI Testing by Learning to Avoid Infeasible Tests}, 
  year={2020},
  volume={},
  number={},
  pages={107-114},
  abstract={Most modern end-user software applications are controlled through a graphical user interface (GUI). When it comes to automated test selection, however, GUIs present two major challenges: (1) It is difficult to automatically identify feasible, non-trivial sequences of GUI interactions (test cases), and (2) each attempt at a test case execution can take a long time, eliminating the possibility of rapidly attempting large numbers of alternatives. In this paper we present an iterative approach that infers state-machine models from previous test executions, and increases the utility of tests by learning which sequences to avoid. The approach is evaluated on a selection of Java applications, and the results indicate that our approach is successful at achieving higher code coverage and longer sequences than the state of the art, albeit with a time-overhead caused by the repeated invocation of a Machine Learner.},
  keywords={Graphical user interfaces;Testing;Tools;Inference algorithms;Androids;Humanoid robots;Automata},
  doi={10.1109/AITEST49225.2020.00023},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11136235,
  author={Babu, V.S.S. Ashish and Paul, K. Ashish and Jaiswal, Rishu and Panda, Niharika},
  booktitle={2025 International Conference on Intelligent Computing and Knowledge Extraction (ICICKE)}, 
  title={Morse Code Decoder using Finite State Automata}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Morse code remains a practical mode of communication in constrained or low-bandwidth environments. However, traditional decoding systems often lack adaptability, scalability, and educational integration. This paper proposes a hybrid Morse code decoding framework that integrates Finite State Automata (FSA) for real-time deterministic decoding and Pushdown Automata (PDA) for handling complex, nested input structures using stack memory. Developed in Python with a Tkinter-based graphical user interface, the system enables users to visualize automata transitions, stack operations, and the decoding process interactively. The decoder achieves over 98.5% accuracy across benchmark Morse sequences, with average decoding times of 12–19 ms per message. Time complexity is maintained at O(n), with space complexity ranging from O(1) to O(n). Experimental results validate the system’s robustness and efficiency, while its visual interactivity enhances understanding of formal language concepts. By bridging the gap between theoretical computation models and practical decoding tasks, the system provides both functional utility and pedagogical value for learners and developers.},
  keywords={Visualization;Codes;Learning automata;Computational modeling;Scalability;Automata;Real-time systems;Decoding;Time complexity;Graphical user interfaces;morse code decoding;finite state automata;pushdown automata;graphical user interface;state diagram;stack-based decoding;automata theory;python;tkinter},
  doi={10.1109/ICICKE65317.2025.11136235},
  ISSN={},
  month={June},}@INPROCEEDINGS{11608651,
  author={Begum, Sultana and Rosenzweig, Michael},
  booktitle={2026 IEEE International Conference on AI and Data Analytics (ICAD)}, 
  title={A Privacy-Preserving On-Device Multi-Agent Architecture for AI PC (POMA) Workflow Automation}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={AI agents that automate desktop workflows can reduce time spent on repetitive knowledge work, but enterprise deployment raises acute privacy and trust challenges. Computer-use agents (CUAs) observe sensitive on-screen content and execute high-impact actions in open-world environments, making them vulnerable to prompt injection and unsafe tool use. Meanwhile, recent model evolution has significantly improved the capabilities of small language and compact multimodal models, enabling specialized low-latency inference that can run fully on-device. This paper presents AIPC-POMA, a privacy-preserving on-device multi-agent architecture for personal and enterprise AI PC workflow automation. AIPC POMA composes a set of carefully crafted, task-specialized small agents including an SLM for drafting, a compact VLM+OCR stack for document and screen understanding, and a sandboxed CUA for GUI interaction coordinated by a local Orchestrator and enforced by a Policy Verifier. POMA is designed around two principles: privacy by minimized data flow and trust by controlled action execution, achieved through least-privilege action primitives, risk-aware gating, and auditable execution traces. We describe a hardware aware implementation optimized for heterogeneous AI acceleration on AI PCs such as Panther Lake-class system, and we introduce an evaluation task suite and adversarial safety battery targeting indirect prompt injection and real-world agent threats. We define metrics spanning utility, latency, privacy leakage, and action safety, demonstrating that POMA enables practical low-cost automation while reducing exposure to untrusted inputs.},
  keywords={Modeling;Artificial intelligence;Printing;Tools;Automation;Privacy;Safety;Optical character recognition;Graphical user interfaces;Large language models;On-device AI;multi-agent systems;workflow automation;privacy-preserving inference;computer-use agents;prompt injections;multimodal models;AI PC;trustworthy autonomy},
  doi={10.1109/ICAD69378.2026.11608651},
  ISSN={},
  month={June},}
