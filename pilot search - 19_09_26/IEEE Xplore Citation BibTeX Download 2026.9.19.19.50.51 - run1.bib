@INBOOK{10789399,
  author={Rizk, Yara and Chakraborti, Tathagata and Isahagian, Vatche and Khazaeni, Yasaman},
  booktitle={Robotic Process Automation: Management, Technology, Applications}, 
  title={8 Towards end-to-end business process automation}, 
  year={2021},
  volume={},
  number={},
  pages={155-168},
  abstract={In recent years, robotic process automation (RPA) emerged as a vehicle to digital transformation in enterprises. However, RPA still possesses many shortcomings that have prevented it from generalizing well to new domains while minimizing coding overhead and approaching end-to-end business process automation. Recent work has looked to utilize artificial intelligence technology to address RPA’s limitations. In this work, we discuss the different approaches to RPA collaboration which is essential to achieving end-to-end automation. From rule-based composition to offline composition using automated planning and online composition using multi-agent orchestration, we present existing approaches in the literature, analyze remaining challenges, and propose insights into future research directions.},
  keywords={Automation},
  doi={},
  ISSN={},
  publisher={De Gruyter},
  isbn={9783110676778},
  url={https://ieeexplore.ieee.org/document/10789399},}@INPROCEEDINGS{10321866,
  author={Paduraru, Ciprian and Cernat, Marina and Staicu, Adelina-Nicoleta},
  booktitle={2023 27th International Conference on Engineering of Complex Computer Systems (ICECCS)}, 
  title={Concolic execution for RPA testing}, 
  year={2023},
  volume={},
  number={},
  pages={187-196},
  abstract={By using Robotic Process Automation (RPA), repetitive processes in companies can be automated and executed with intelligent software agents. These agents are able to run such processes without human effort and with less error-proneness. RPA has gained significant traction in recent years and is being used by many companies to reduce internal costs and achieve a higher return on investment (ROI). In our literature review, we found that there is a gap in the testability of RPA workflows. In this paper, we focus on addressing this gap using concolic execution (also referred to as online symbolic execution in the literature). First, we explore how previous work in the literature on concolic execution can be reused for the RPA domain and we implement a prototype. Then, we evaluate our open source solution for adapting concolic execution to the RPA context, using real-world use cases and best practices.},
  keywords={Intelligent automation;Costs;Bibliographies;Prototypes;Companies;Software agents;Best practices;RPA;autonomous testing;workflows;concolic execution;software agents},
  doi={10.1109/ICECCS59891.2023.00031},
  ISSN={2770-8535},
  month={June},}@INPROCEEDINGS{11629951,
  author={Rastogi, Tanishka and Prasad, Sudha Shanker},
  booktitle={2026 5th OPJU International Technology Conference (OTCON) on Smart Computing for Innovation and Advancement in Industry 5.0}, 
  title={Design and Implementation of a Hybrid Ontology-NLP Autonomous Web Agent for Intelligent Information Interaction}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={The next generation of the intelligent adaptive and user centric web interaction is now taking the form of autonomous web agents. Although ontology based agents are more semantically precise and explainable, they are frequently not flexible to natural language inputs. In contrast, NLP motivated models are not only flexible linguistically, but are black box systems with poor transparency. This paper discusses the design and implementation of a hybrid ontology, NLP autonomous web agent which involves combination of symbolic reasoning with language understanding in order to acquire both interpretability and contextual adaptability. The system architecture integrates semantic validation in the form of SPARQL reasoning and rule based planning with natural language intent recognition and entity extraction. The suitability of the approach is confirmed with a prototype of the proof-of-concept healthcare questionanswering that works with the publicly available MedQuAD benchmark. According to experimental findings, the success rate in the tasks, semantic consistency, and the explanation are better than those of standalone ontology or NLP based models. The suggested hybrid system offers a useful basis for credible, areaconscientious, and classifiable autonomous representatives in Web 4.0 ecosystems.},
  keywords={Modeling;Ontologies;Natural language processing;Cognition;Cognitive systems;Printing;Autonomous agents;Medical services;Natural languages;Equations;Autonomous Web Agents;Hybrid Intelligence;Ontology;Natural Language Processing;Semantic Web;Explainable AI;Knowledge Reasoning;Web 4.0;Intelligent Information Retrieval;Adaptive Agents},
  doi={10.1109/OTCON69332.2026.11629951},
  ISSN={},
  month={June},}
